<section
  id="MinimalSlideshow-{{ section.id }}"
  class="minimal-slideshow"
  style="--slide-height: {{ section.settings.height }}px; --section-background: {{ section.settings.background_color }};"
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.delay | times: 1000 }}"
  data-navigation="{{ section.settings.show_navigation }}"
>
  <div class="swiper minimal-slideshow__swiper" data-minimal-swiper role="region" aria-roledescription="carousel" aria-label="{{ section.settings.accessible_label }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign fallback_image_asset = blank %}
        {% if forloop.index == 1 %}
          {% assign fallback_image_asset = 'slide-1-v2.webp' %}
        {% elsif forloop.index == 2 %}
          {% assign fallback_image_asset = 'slide-2-v2.webp' %}
        {% endif %}
        <article class="swiper-slide minimal-slideshow__slide" {{ block.shopify_attributes }}>
        <div class="minimal-slideshow__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 2800 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--desktop', widths: '750, 1100, 1500, 2000, 2800', sizes: '100vw', loading: 'eager' }}
          {% elsif section.settings.desktop_image != blank %}
            {{ section.settings.desktop_image | image_url: width: 2800 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--desktop', widths: '750, 1100, 1500, 2000, 2800', sizes: '100vw', loading: 'eager' }}
          {% elsif fallback_image_asset != blank %}
            <img src="{{ fallback_image_asset | asset_url }}" class="minimal-slideshow__image minimal-slideshow__image--desktop" width="1280" height="640" alt="{{ block.settings.heading | escape }}" loading="eager">
          {% else %}
            <div class="minimal-slideshow__fallback minimal-slideshow__fallback--{{ forloop.index }}" aria-hidden="true"></div>
          {% endif %}

          {% if block.settings.mobile_image != blank %}
            {{ block.settings.mobile_image | image_url: width: 1400 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--mobile', widths: '480, 750, 1000, 1400', sizes: '100vw', loading: 'eager' }}
          {% elsif section.settings.mobile_image != blank %}
            {{ section.settings.mobile_image | image_url: width: 1400 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--mobile', widths: '480, 750, 1000, 1400', sizes: '100vw', loading: 'eager' }}
          {% elsif block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--mobile', widths: '480, 750, 1000, 1400', sizes: '100vw', loading: 'eager' }}
          {% elsif section.settings.desktop_image != blank %}
            {{ section.settings.desktop_image | image_url: width: 1400 | image_tag: class: 'minimal-slideshow__image minimal-slideshow__image--mobile', widths: '480, 750, 1000, 1400', sizes: '100vw', loading: 'eager' }}
          {% elsif fallback_image_asset != blank %}
            <img src="{{ fallback_image_asset | asset_url }}" class="minimal-slideshow__image minimal-slideshow__image--mobile" width="1280" height="640" alt="" loading="eager">
          {% endif %}

          <span class="minimal-slideshow__veil" style="--veil: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></span>
        </div>

        <div class="minimal-slideshow__content minimal-slideshow__content--{{ section.settings.content_position }} color-{{ block.settings.content_color }}">
          <div class="minimal-slideshow__copy">
            {% if block.settings.eyebrow != blank %}
              <p class="minimal-slideshow__eyebrow">{{ block.settings.eyebrow }}</p>
            {% endif %}

            <h2 class="minimal-slideshow__heading">
              {{ block.settings.heading }}
              {% if block.settings.heading_emphasis != blank %}
                <span class="minimal-slideshow__heading-line">{{ block.settings.heading_emphasis }}</span>
              {% endif %}
            </h2>

            {% if block.settings.button_label != blank %}
              {% assign button_href = block.settings.button_link | default: routes.all_products_collection_url %}
              <a
                class="minimal-slideshow__button minimal-slideshow__button--{{ block.settings.button_style | default: 'primary' }} minimal-slideshow__button--{{ block.settings.button_size | default: 'large' }}{% if block.settings.button_icon_only %} minimal-slideshow__button--icon-only{% endif %}{% if block.settings.button_full_width_mobile %} minimal-slideshow__button--full-width-mobile{% endif %}"
                href="{{ button_href }}"
                {% if block.settings.button_icon_only %}aria-label="{{ block.settings.button_label | escape }}"{% endif %}
                data-button-animation="{{ block.settings.button_animation }}"
                style="--button-animation-delay: {{ block.settings.button_animation_delay }}ms;"
              >
                <span {% if block.settings.button_icon_only %}class="visually-hidden"{% endif %}>{{ block.settings.button_label }}</span>
                {% if block.settings.button_icon != 'none' %}
                  <span class="minimal-slideshow__button-icon minimal-slideshow__button-icon--{{ block.settings.button_icon_style | default: 'solid' }} minimal-slideshow__button-icon--{{ block.settings.button_icon | default: 'caret-right' }}" aria-hidden="true">
                    <span class="minimal-slideshow__button-icon-glyph">{% if block.settings.button_icon == 'caret-right' %}›{% else %}→{% endif %}</span>
                  </span>
                {% endif %}
              </a>
            {% endif %}
          </div>
        </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 and section.settings.show_navigation %}
      <div class="minimal-slideshow__navigation">
        <p class="minimal-slideshow__count"><span data-current>1</span> / <span>{{ section.blocks.size }}</span></p>
        <div class="minimal-slideshow__progress" aria-hidden="true"><span data-progress></span></div>
        <button type="button" data-previous aria-label="{{ 'slideshow.previous' | t }}">←</button>
        <button type="button" data-next aria-label="{{ 'slideshow.next' | t }}">→</button>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .minimal-slideshow { display: block; background: var(--section-background); }
  .minimal-slideshow__swiper { position: relative; min-height: var(--slide-height); overflow: hidden; }
  .minimal-slideshow__slide { position: relative; min-height: var(--slide-height); }
  .minimal-slideshow__media, .minimal-slideshow__image, .minimal-slideshow__fallback, .minimal-slideshow__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .minimal-slideshow__image { display: block; object-fit: cover; }
  .minimal-slideshow__image--mobile { display: none; }
  .minimal-slideshow__fallback { background: #c7c7c7; }
  .minimal-slideshow__fallback--1 { background: linear-gradient(135deg, #c6c7c6 0%, #b8b9b7 48%, #cfcfcd 100%); }
  .minimal-slideshow__fallback--2 { background: linear-gradient(135deg, #abb9aa 0%, #d5d8ca 50%, #b1aaa0 100%); }
  .minimal-slideshow__fallback--3 { background: linear-gradient(135deg, #d4c0ae 0%, #c4a997 48%, #cfc6b7 100%); }
  .minimal-slideshow__veil { background: #111; opacity: var(--veil); }
  .minimal-slideshow__content { position: absolute; inset: 0; z-index: 1; display: flex; align-items: flex-end; width: min(100% - 7.5rem, 100rem); margin: 0 auto; padding: clamp(3.5rem, 7vw, 7.5rem) 0; }
  .minimal-slideshow__content--bottom-left { justify-content: flex-start; align-items: flex-end; text-align: left; }
  .minimal-slideshow__content--bottom-center { justify-content: center; align-items: flex-end; text-align: center; }
  .minimal-slideshow__content--middle-left { justify-content: flex-start; align-items: center; text-align: left; }
  .minimal-slideshow__content--middle-center { justify-content: center; align-items: center; text-align: center; }
  .minimal-slideshow__content--middle-right { justify-content: flex-end; align-items: center; text-align: right; }
  .minimal-slideshow__content--bottom-right { justify-content: flex-end; align-items: flex-end; text-align: right; }
  .minimal-slideshow__content--bottom-center .minimal-slideshow__copy, .minimal-slideshow__content--middle-center .minimal-slideshow__copy { display: flex; flex-direction: column; align-items: center; }
  .minimal-slideshow__content--middle-right .minimal-slideshow__copy, .minimal-slideshow__content--bottom-right .minimal-slideshow__copy { display: flex; flex-direction: column; align-items: flex-end; }
  .minimal-slideshow__copy { max-width: 31rem; }
  .minimal-slideshow__eyebrow { margin: 0 0 1.8rem; font-family: var(--font-primary--family); font-size: 15px; font-weight: 700; letter-spacing: 0; line-height: 1.6; text-transform: uppercase; }
  .minimal-slideshow__heading { margin: 0; font-family: var(--font-primary--family); font-size: clamp(3.8rem, calc(5.848vw - 0.685rem), 6.8rem); font-weight: 700; line-height: 0.93; letter-spacing: 0; }
  .minimal-slideshow__heading-line { display: block; font-family: inherit; font-size: inherit; font-style: normal; font-weight: inherit; letter-spacing: inherit; }
  .minimal-slideshow__button { --button-padding-inline: 24px; --button-icon-solid-size: 15px; --button-icon-gap: 6px; --button-height: 50px; position: relative; z-index: 0; display: inline-flex; align-items: center; justify-content: center; min-width: 0; min-height: var(--button-height); margin-top: 2.5rem; padding: 10px calc(10px + (var(--button-icon-solid-size) * 2) + var(--button-icon-gap)) 10px var(--button-padding-inline); overflow: hidden; border: 0; border-radius: 999px; background: #fff; color: #000; font-family: var(--font-primary--family); font-size: 15px; font-style: var(--font-primary--style); font-weight: 700; letter-spacing: 0; line-height: 1; text-align: center; text-decoration: none; text-transform: none; white-space: nowrap; cursor: pointer; transition: background-color 260ms ease, color 260ms ease, transform 260ms cubic-bezier(.22, .61, .36, 1); }
  .minimal-slideshow__button--primary:hover { transform: translateY(-2px); border-color: #fff; background: #000; color: #fff; }
  .minimal-slideshow__button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .minimal-slideshow__button--secondary { border: 1px solid currentColor; background: transparent; color: inherit; }
  .minimal-slideshow__button--link { min-height: auto; padding: 0; border-radius: 0; background: transparent; color: inherit; text-decoration: underline; text-underline-offset: 0.25em; }
  .minimal-slideshow__button--small { --button-icon-solid-size: 13px; --button-height: 42px; --button-padding-inline: 20px; font-size: 14px; }
  .minimal-slideshow__button--large { --button-icon-solid-size: 15px; --button-height: 50px; --button-padding-inline: 24px; font-size: 15px; }
  .minimal-slideshow__button--icon-only { width: var(--button-height); padding: 0; }
  .minimal-slideshow__button-icon { position: absolute; top: 50%; right: 10px; display: flex; width: calc(var(--button-icon-solid-size) * 2); height: calc(var(--button-icon-solid-size) * 2); align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; border-radius: 50%; color: currentColor; font-size: 1.4rem; line-height: 1; transform: translateY(-50%); transition: all 260ms cubic-bezier(.22, .61, .36, 1); }
  .minimal-slideshow__button-icon-glyph { display: block; transform: translateX(0); transition: transform 260ms cubic-bezier(.22, .61, .36, 1); }
  .minimal-slideshow__button-icon--caret-right .minimal-slideshow__button-icon-glyph { width: 7px; height: 7px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; font-size: 0; transform: rotate(45deg); }
  .minimal-slideshow__button:hover .minimal-slideshow__button-icon { transform: translateY(-50%) scale(1.06); }
  .minimal-slideshow__button:hover .minimal-slideshow__button-icon-glyph { transform: translateX(2px); }
  .minimal-slideshow__button--primary:hover .minimal-slideshow__button-icon--solid { background: transparent; color: #fff; transform: translateY(-50%); }
  .minimal-slideshow__button--primary:hover .minimal-slideshow__button-icon--solid .minimal-slideshow__button-icon-glyph { transform: translateX(0); }
  .minimal-slideshow__button--primary:hover .minimal-slideshow__button-icon--caret-right .minimal-slideshow__button-icon-glyph { animation: minimal-slideshow-chevron-loop 900ms cubic-bezier(.45, .05, .55, .95) infinite; }
  .minimal-slideshow__button--small .minimal-slideshow__button-icon { right: 7px; }
  .minimal-slideshow__button--large .minimal-slideshow__button-icon { right: 12px; }
  .minimal-slideshow__button--icon-only .minimal-slideshow__button-icon { position: static; transform: none; }
  .minimal-slideshow__button--icon-only:hover .minimal-slideshow__button-icon { transform: scale(1.1); }
  .minimal-slideshow__button-icon--solid { background: #161616; color: #fff; }
  @keyframes minimal-slideshow-chevron-loop { 0%, 100% { transform: translateX(0) rotate(45deg); } 50% { transform: translateX(6px) rotate(45deg); } }
  .minimal-slideshow__button--secondary:hover { background: rgba(255, 255, 255, 0.18); }
  .minimal-slideshow__button--link:hover { box-shadow: none; transform: none; text-decoration-thickness: 2px; }
  .minimal-slideshow__button.is-button-animating[data-button-animation='fade-up'] { animation: minimal-slideshow-fade-up 550ms cubic-bezier(.22, .61, .36, 1) var(--button-animation-delay) both; }
  .minimal-slideshow__button.is-button-animating[data-button-animation='fade-in'] { animation: minimal-slideshow-fade-in 450ms ease var(--button-animation-delay) both; }
  @keyframes minimal-slideshow-fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes minimal-slideshow-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .minimal-slideshow__navigation { position: absolute; right: clamp(1.5rem, 4vw, 5rem); bottom: clamp(2rem, 4vw, 4rem); z-index: 2; display: flex; align-items: center; gap: 1.1rem; color: #fff; }
  .minimal-slideshow__count { margin: 0; min-width: 2.4rem; font-size: 0.86rem; font-weight: 700; white-space: nowrap; }
  .minimal-slideshow__progress { width: clamp(5rem, 10vw, 8rem); height: 1px; background: rgba(255, 255, 255, 0.55); }
  .minimal-slideshow__progress span { display: block; width: 50%; height: 100%; background: #fff; transition: width 500ms ease; }
  .minimal-slideshow__navigation button { padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; font: inherit; font-size: 1.35rem; line-height: 1; }
  .minimal-slideshow .color-light { color: #fff; }
  .minimal-slideshow .color-dark { color: #1b1b1b; }
  @media (max-width: 749px) {
    .minimal-slideshow__swiper, .minimal-slideshow__slide { min-height: clamp(32rem, 122vw, 38rem); }
    .minimal-slideshow__image--desktop { display: none; }
    .minimal-slideshow__image--mobile { display: block; }
    .minimal-slideshow__content { align-items: flex-end; justify-content: center; width: min(100% - 2rem, 28rem); padding: 3rem 0 4.4rem; text-align: center; }
    .minimal-slideshow__content--bottom-left, .minimal-slideshow__content--bottom-right, .minimal-slideshow__content--middle-left, .minimal-slideshow__content--middle-right { justify-content: center; text-align: center; }
    .minimal-slideshow__content--bottom-left .minimal-slideshow__copy, .minimal-slideshow__content--bottom-right .minimal-slideshow__copy, .minimal-slideshow__content--middle-left .minimal-slideshow__copy, .minimal-slideshow__content--middle-right .minimal-slideshow__copy { align-items: center; }
    .minimal-slideshow__copy { width: 100%; max-width: 22rem; }
    .minimal-slideshow__eyebrow { margin-bottom: 1.4rem; font-size: 14px; }
    .minimal-slideshow__heading { font-size: clamp(2.5rem, 11vw, 3rem); line-height: 0.98; }
    .minimal-slideshow__button { display: flex; width: 100%; min-height: 50px; margin-top: 2rem; }
    .minimal-slideshow__button--full-width-mobile { width: 100%; }
    .minimal-slideshow__navigation { right: 1.25rem; bottom: 1.5rem; left: 1.25rem; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 0.9rem; }
    .minimal-slideshow__count { min-width: 2.15rem; font-size: 0.8rem; }
    .minimal-slideshow__progress { width: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .minimal-slideshow__button, .minimal-slideshow__button-icon, .minimal-slideshow__button-icon-glyph { transition: none; }
    .minimal-slideshow__button:hover, .minimal-slideshow__button:hover .minimal-slideshow__button-icon, .minimal-slideshow__button:hover .minimal-slideshow__button-icon-glyph { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  const initializeMinimalSlideshows = () => {
    document.querySelectorAll('[data-minimal-swiper]').forEach((element) => {
      if (element.dataset.initialized === 'true' || typeof Swiper === 'undefined') return

      const section = element.closest('.minimal-slideshow')
      const current = section.querySelector('[data-current]')
      const progress = section.querySelector('[data-progress]')
      const previous = section.querySelector('[data-previous]')
      const next = section.querySelector('[data-next]')
      const autoplayEnabled = section.dataset.autoplay === 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const navigationEnabled = section.dataset.navigation === 'true'

      const updateControls = (swiper) => {
        if (current) current.textContent = String(swiper.realIndex + 1)
        if (progress) progress.style.width = `${((swiper.realIndex + 1) / swiper.slides.length) * 100}%`
      }

      const animateActiveButton = (swiper) => {
        section.querySelectorAll('[data-button-animation]').forEach((button) => button.classList.remove('is-button-animating'))
        const activeButton = swiper.slides[swiper.activeIndex]?.querySelector('[data-button-animation]:not([data-button-animation="none"])')
        if (activeButton) requestAnimationFrame(() => activeButton.classList.add('is-button-animating'))
      }

      const swiper = new Swiper(element, {
        a11y: { enabled: true },
        autoplay: autoplayEnabled ? { delay: Number(section.dataset.delay), disableOnInteraction: false, pauseOnMouseEnter: true } : false,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        keyboard: { enabled: true },
        navigation: navigationEnabled ? { nextEl: next, prevEl: previous } : false,
        speed: 650,
        on: {
          init: (instance) => {
            updateControls(instance)
            animateActiveButton(instance)
          },
          slideChange: updateControls,
          slideChangeTransitionStart: animateActiveButton
        }
      })

      element.dataset.initialized = 'true'
      updateControls(swiper)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeMinimalSlideshows)
  } else {
    initializeMinimalSlideshows()
  }
{% endjavascript %}

{% schema %}
{
  "name": "Minimal slideshow",
  "settings": [
    { "type": "header", "content": "Slideshow" },
    { "type": "text", "id": "accessible_label", "label": "Accessible label", "default": "Featured stories" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#c7c7c7" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 540, "max": 960, "step": 20, "unit": "px", "default": 700 },
    { "type": "header", "content": "Slide appearance" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{ "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }, { "value": "middle-left", "label": "Middle left" }, { "value": "middle-center", "label": "Middle center" }, { "value": "middle-right", "label": "Middle right" }], "default": "bottom-left" },
    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "delay", "label": "Autoplay delay", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": true }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Slide media overrides" },
        { "type": "image_picker", "id": "image", "label": "Desktop image override" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image override" },
        { "type": "header", "content": "Content" },
        { "type": "select", "id": "content_color", "label": "Content color", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }], "default": "light" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Little moments" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Wrapped" },
        { "type": "text", "id": "heading_emphasis", "label": "Second heading line", "default": "in warmth" },
        { "type": "header", "content": "Button" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop collection" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "link", "label": "Text link" }], "default": "primary" },
        { "type": "select", "id": "button_size", "label": "Size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
        { "type": "select", "id": "button_icon", "label": "Icon", "options": [{ "value": "none", "label": "None" }, { "value": "caret-right", "label": "Caret right" }, { "value": "arrow-right", "label": "Arrow right" }], "default": "caret-right" },
        { "type": "checkbox", "id": "button_icon_only", "label": "Icon only", "default": false },
        { "type": "select", "id": "button_icon_style", "label": "Icon style", "options": [{ "value": "default", "label": "Default" }, { "value": "solid", "label": "Solid" }], "default": "solid" },
        { "type": "header", "content": "Mobile settings" },
        { "type": "checkbox", "id": "button_full_width_mobile", "label": "Enable full width on mobile", "default": false },
        { "type": "header", "content": "Animation" },
        { "type": "select", "id": "button_animation", "label": "Type", "options": [{ "value": "none", "label": "None" }, { "value": "fade-up", "label": "Fade up" }, { "value": "fade-in", "label": "Fade in" }], "default": "fade-up" },
        { "type": "range", "id": "button_animation_delay", "label": "Delay", "min": 0, "max": 1000, "step": 50, "unit": "ms", "default": 250 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Minimal slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "eyebrow": "New little things", "heading": "Made for", "heading_emphasis": "everyday wonder", "button_label": "Explore now" } },
        { "type": "slide", "settings": { "eyebrow": "Small stories", "heading": "Made to", "heading_emphasis": "move with them", "button_label": "See the edit" } }
      ]
    }
  ]
}
{% endschema %}
